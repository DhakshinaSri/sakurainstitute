# Copy this file to ".env" and fill in your real values.

# Public URL of the live site (used for canonical links, sitemap, social tags). No trailing slash.
VITE_SITE_URL=https://www.your-domain.com

# Public contact e-mail (shown on the Contact page and used as mail fallback).
VITE_CONTACT_EMAIL=

# Optional: URL that accepts the enquiry form as a POST (Formspree, Getform, your own API...).
VITE_FORM_ENDPOINT=
